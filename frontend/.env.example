# URL pública da API, incluindo o prefixo /api e SEM barra final.
# É embutida no bundle em tempo de build: alterou o valor, faça um novo deploy.
# Em desenvolvimento, se omitida, usa http://localhost:8080/api.
# Na Vercel (Production) ela é obrigatória; o build falha sem ela.
NEXT_PUBLIC_API_URL=https://api.exemplo.com/api

# Upload de imagens de produtos (Cloudinary, upload direto do navegador, "unsigned").
# Valores públicos por natureza (aparecem no bundle). Se omitidos, o código usa os padrões
# "dn_store" / "dn_store_preset": em produção, defina os valores da SUA conta.
# No Cloudinary, restrinja o upload preset (formatos de imagem, tamanho máximo e pasta);
# quem conhece o preset consegue enviar arquivos para a sua conta.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=<seu-cloud-name>
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=<seu-upload-preset-unsigned>
