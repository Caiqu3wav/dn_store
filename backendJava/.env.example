# Configure these values with the connection details from Aiven.
DB_URL=jdbc:mysql://<host-aiven>:<porta>/<database>?ssl-mode=REQUIRED
DB_USER=avnadmin
DB_PASS=<senha-do-aiven>

# Generate unique secrets for your local environment. Never use these example values in production.
JWT_SECRET=sUsCUX0i9eYOYbj0aan1bVo9LxWpQRTrCxq+XRTPQrM=
AUTH_CHALLENGE_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=86400000

# Optional application settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DDL_AUTO=validate

# Instagram API with Instagram Login; configure each professional account separately.
# Use long-lived Instagram User Access Tokens. Keep the token values private.
INSTAGRAM_MTB_USER_ID=
INSTAGRAM_MTB_ACCESS_TOKEN=
INSTAGRAM_STORE_USER_ID=
INSTAGRAM_STORE_ACCESS_TOKEN=
INSTAGRAM_MEDIA_CACHE_TTL_MS=900000
INSTAGRAM_TOKEN_REFRESH_INTERVAL_MS=86400000
INSTAGRAM_TOKEN_REFRESH_INITIAL_DELAY_MS=86400000
