# Configure these values with the connection details from Aiven.
DB_URL=jdbc:mysql://<host-aiven>:<porta>/<database>?ssl-mode=REQUIRED
DB_USER=avnadmin
DB_PASS=<senha-do-aiven>

# Generate unique secrets for your local environment. Never use these example values in production.
JWT_SECRET=<base64-encoded-random-secret>
AUTH_CHALLENGE_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=86400000

# Optional application settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DDL_AUTO=validate

# Melhor Envio: use the URLs and scopes registered for the selected app environment.
# The OAuth client credentials are app credentials; account tokens are granted through authorization.
SHIPPING_GATEWAY=melhorEnvio
ORIGIN_ZIP_CODE=<store-origin-postal-code>
MELHOR_ENVIO_ENV=sandbox
MELHOR_ENVIO_CLIENT_ID=<application-client-id>
MELHOR_ENVIO_CLIENT_SECRET=<application-client-secret>
MELHOR_ENVIO_REDIRECT_URI=https://<your-backend-host>/api/integrations/melhor-envio/callback
MELHOR_ENVIO_API_BASE_URL=<documented-sandbox-api-base-url>
MELHOR_ENVIO_AUTHORIZATION_URL=<documented-sandbox-authorization-url>
MELHOR_ENVIO_TOKEN_URL=<documented-sandbox-token-url>
MELHOR_ENVIO_SCOPES=shipping-calculate
MELHOR_ENVIO_USER_AGENT=DN-Store/1.0 (support@example.com)
MELHOR_ENVIO_TOKEN_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
MELHOR_ENVIO_STATE_TTL=PT10M
MELHOR_ENVIO_REFRESH_SKEW=PT5M
MELHOR_ENVIO_REFRESH_TOKEN_TTL=PT720H
SHIPPING_QUOTE_TTL=PT15M
SHIPPING_HTTP_CONNECT_TIMEOUT=PT3S
SHIPPING_HTTP_READ_TIMEOUT=PT10S
