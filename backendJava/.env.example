# ── Perfil e rede ───────────────────────────────────────────────────────────
# local   = desenvolvimento (padrão do docker compose); logs DEBUG, frete simulado permitido.
# staging = hospedagem de teste; exige Melhor Envio sandbox. Mesmas proteções do prod.
# prod    = produção; exige MELHOR_ENVIO_ENV=production e SHIPPING_GATEWAY=melhorEnvio.
# A imagem Docker já usa "prod" por padrão.
SPRING_PROFILES_ACTIVE=local
# A porta é definida pela plataforma de hospedagem via PORT; padrão 8080.
# PORT=8080
# Opcional: opções da JVM no container (padrão da imagem: -XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError).
# JAVA_OPTS=-XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError

# ── URLs do frontend (obrigatórias em staging/prod) ─────────────────────────
# FRONTEND_URL: usada nos links de e-mail e no redirecionamento do OAuth do Melhor Envio.
# CORS_ALLOWED_ORIGINS (mais abaixo): origens exatas do frontend, separadas por vírgula, sem barra final.
FRONTEND_URL=http://localhost:3000

# Configure these values with the connection details from Aiven.
DB_URL=jdbc:mysql://<host-aiven>:<porta>/<database>?ssl-mode=REQUIRED
DB_USER=avnadmin
DB_PASS=<senha-do-aiven>
# Tamanho do pool de conexões em produção (padrão 10). Respeite o limite do plano do banco.
# DB_POOL_SIZE=10

# Generate unique secrets for your local environment. Never use these example values in production.
JWT_SECRET=<base64-encoded-random-secret>
AUTH_CHALLENGE_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=86400000

# E-mail (Resend). Sem RESEND_API_KEY todo envio falha com 503 ("Email delivery is not configured"):
# código de verificação, código MFA e recuperação de senha. Use um remetente de domínio verificado no Resend.
RESEND_API_KEY=<resend-api-key>
RESEND_FROM=DN Store <onboarding@resend.dev>

# Optional application settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DDL_AUTO=validate

# Melhor Envio: use the URLs and scopes registered for the selected app environment.
# The OAuth client credentials are app credentials; account tokens are granted through authorization.
SHIPPING_GATEWAY=melhorEnvio
ORIGIN_ZIP_CODE=<store-origin-postal-code>
MELHOR_ENVIO_ENV=sandbox
MELHOR_ENVIO_CLIENT_ID=<application-client-id>
MELHOR_ENVIO_CLIENT_SECRET=<application-client-secret>
MELHOR_ENVIO_REDIRECT_URI=https://<your-backend-host>/api/integrations/melhor-envio/callback
MELHOR_ENVIO_API_BASE_URL=<documented-sandbox-api-base-url>
MELHOR_ENVIO_AUTHORIZATION_URL=<documented-sandbox-authorization-url>
MELHOR_ENVIO_TOKEN_URL=<documented-sandbox-token-url>
MELHOR_ENVIO_SCOPES=shipping-calculate
MELHOR_ENVIO_USER_AGENT=DN-Store/1.0 (support@example.com)
MELHOR_ENVIO_TOKEN_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
MELHOR_ENVIO_STATE_TTL=PT10M
MELHOR_ENVIO_REFRESH_SKEW=PT5M
MELHOR_ENVIO_REFRESH_TOKEN_TTL=PT1080H
# Renovação proativa: começa quando faltam MELHOR_ENVIO_PROACTIVE_REFRESH_WINDOW para o access token vencer.
MELHOR_ENVIO_PROACTIVE_REFRESH_WINDOW=P7D
SHIPPING_QUOTE_REUSE_WINDOW=PT5M
SHIPPING_QUOTE_RATE_LIMIT_REQUESTS=10
SHIPPING_QUOTE_RATE_LIMIT_WINDOW=PT1M
SHIPPING_QUOTE_TTL=PT15M
SHIPPING_HTTP_CONNECT_TIMEOUT=PT3S
SHIPPING_HTTP_READ_TIMEOUT=PT10S

# Asaas: the environment and base URL must belong to the same account credentials.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=<sandbox-api-key>
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=<sandbox-webhook-token>
ASAAS_USER_AGENT=DN-Store/1.0
ASAAS_HTTP_CONNECT_TIMEOUT=PT3S
ASAAS_HTTP_READ_TIMEOUT=PT10S
PAYMENT_WEBHOOK_SCAN_MS=1000
PAYMENT_WEBHOOK_LEASE_MINUTES=10
PAYMENT_WEBHOOK_MAX_ATTEMPTS=8
PAYMENT_ORDER_EXPIRATION_MINUTES=60
PAYMENT_EXPIRATION_SCAN_MS=60000
